# ===============================================================
# PROPRIETARY DATA — must never enter this repository
# ===============================================================
# This is a code-only repository. The MolPort Natural Products
# library and every result derived from it (predictions, rankings,
# hit lists) are proprietary and stay out of version control.
#
# Public reference data under data/reference/ is exempt; see the
# explicit allow-rules at the bottom of this file.
# ---------------------------------------------------------------
molport_all.zip
molport*.csv
molport*.xlsx
Molport*.zip
Molport*.xlsx
ligands_ranked*.csv
*_with_predictions*.csv
novelty_check_results.csv
smiles_overlap.csv
top100*.csv
hits*.csv

# ---------------------------------------------------------------
# Data and model outputs
# ---------------------------------------------------------------
data/
results/
output/
logging/
*.log
*.zip
*.rar
*.tar.gz
*.a3m
*.cif
*.pdb
*.npz
*.ckpt
*.pt
*.sdf
*.mol2

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Local configuration (config.example.yaml is tracked)
# ---------------------------------------------------------------
config.yaml
config.local.yaml
*.yaml.bak
.env

# ---------------------------------------------------------------
# IDE and OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ===============================================================
# Allow-rules — MUST come last to override the exclusions above
# ===============================================================
# Public inputs only. Everything here must be traceable to a public
# source (ChEMBL, UniProt, RCSB) and carry a provenance note in
# data/README.md. Screening results and the library itself stay out.
!data/
data/*
!data/README.md

# Reference compounds — ChEMBL
!data/reference/
!data/reference/known_ca2_inhibitors.csv
!data/reference/README.md

# Re-including a directory does not re-exclude what is inside it: "data/*"
# matches "data/fasta" but not "data/fasta/x". Each folder therefore needs its
# own "<dir>/*" line before the allow-rules for the files that may pass.

# Target sequences — UniProt
!data/fasta/
data/fasta/*
!data/fasta/*.fasta

# Alignments — generated from the public sequences above.
# Listed one by one: these are the three used in the thesis. A fourth
# file, P22748_mit_Signal.a3m, belongs to the untrimmed hCA IV sequence
# that was superseded and is deliberately left untracked.
!data/msa/
data/msa/*
!data/msa/P00918.a3m
!data/msa/P22748_mat.a3m
!data/msa/P43166.a3m

# Apo receptor for DiffDock — RCSB
!data/pdb/
data/pdb/*
!data/pdb/1CNC.pdb

# Demo compound set — vendor catalogue entries, see data/demo/README.md.
# Named one by one on purpose: a blanket "*.csv" here would override the
# "molport*.csv" exclusion above and let the full annotated library through.
!data/demo/
data/demo/*
!data/demo/demo_100.csv
!data/demo/demo_10.csv
!data/demo/README.md

# Reference set folder, same rule
data/reference/*
!data/reference/known_ca2_inhibitors.csv
!data/reference/README.md

# ---------------------------------------------------------------------------
# Example outputs — produced from data/demo/, never from the screening library.
# Same directory rule as above: re-including results/example/ does not
# re-exclude what lands inside it, so the contents are listed by extension and
# the proprietary patterns at the top of this file still win over *.csv here.
# ---------------------------------------------------------------------------
!results/
results/*
!results/example/
results/example/*
!results/example/**/
!results/example/README.md
!results/example/**/*.yaml
!results/example/**/*.png
# CSVs by exact shape, not "demo_*.csv": a top-N export of a 100-compound demo
# list is byte-identical to the full one, and a blanket rule kept re-adding it.
!results/example/demo_*_ranked_full.csv
